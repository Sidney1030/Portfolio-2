<style>
/* ===== 1. COULEURS ET BASE (change les couleurs ici) ===== */
:root{--bg:#000;--panel:#101012;--ink:#f4f4f5;--mute:#a1a1aa;--line:#26262b;--acc:#7aa2ff;--acc2:#38e0c8;--warm:#ffb86b;--pink:#ff7eb6;--soft:#1b1f2a;color-scheme:dark}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:60px}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1rem/1.7 "Manrope","Segoe UI",Arial,sans-serif}
h1,h2,h3,h4{margin:0;line-height:1.2}
a{color:var(--acc)}
:focus-visible{outline:3px solid var(--acc);outline-offset:3px}
.wrap{max-width:960px;margin:0 auto;padding:0 24px}
section{padding:64px 0;border-top:1px solid var(--line)}
h2{font-size:1.9rem;font-weight:800;margin-bottom:8px}
.sub{color:var(--mute);margin:0 0 32px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:40px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:22px 24px}

/* ===== 2. MENU ===== */
nav{position:sticky;top:0;z-index:5;background:var(--bg);border-bottom:1px solid var(--line)}
nav .wrap{display:flex;align-items:center;gap:6px;overflow-x:auto;padding-top:12px;padding-bottom:12px}
nav b{margin-right:auto;padding-right:16px;white-space:nowrap}
nav a{color:var(--mute);text-decoration:none;font-size:.92rem;padding:4px 10px;white-space:nowrap}
nav a.on{color:var(--acc);font-weight:700}

/* ===== 3. ACCUEIL ===== */
header{padding:clamp(48px,9vw,96px) 0}
header .wrap{display:grid;grid-template-columns:1.2fr 1fr;gap:40px;align-items:center}
.tag{display:inline-block;background:var(--soft);color:var(--acc);font-weight:700;font-size:.9rem;padding:4px 14px;border-radius:99px;margin-bottom:18px}
h1{font-size:clamp(2.3rem,6vw,3.8rem);font-weight:800;letter-spacing:-.03em}
h1 span{background:linear-gradient(90deg,var(--acc),var(--acc2));-webkit-background-clip:text;background-clip:text;color:transparent}
header p{color:var(--mute);font-size:1.15rem;margin:18px 0 28px;max-width:30em}
.btn{display:inline-block;padding:12px 22px;background:linear-gradient(135deg,var(--acc),var(--acc2));color:#000;border-radius:8px;font-weight:700;text-decoration:none;margin:0 8px 8px 0;transition:transform .25s}
.btn:hover{transform:translateY(-3px)}
.btn.alt{background:none;color:var(--ink);border:1px solid var(--line)}
.code{background:#0a0a0c;border:1px solid var(--line);border-radius:12px;padding:20px 22px;font:.9rem/1.7 ui-monospace,Consolas,monospace;overflow-x:auto;margin:0}
.code i{color:#8ab4ff;font-style:normal}
.code em{color:#e9c98a;font-style:normal}
.cur{display:inline-block;width:8px;height:1em;background:#8ab4ff;vertical-align:-2px;animation:blink 1s steps(2) infinite}
@keyframes blink{50%{opacity:0}}

/* ===== 4. COMPETENCES (les animations sont ici) ===== */
.bar{margin-bottom:18px}
.bar div{display:flex;justify-content:space-between;margin-bottom:6px}
.bar .track{height:8px;background:var(--line);border-radius:9px;overflow:hidden}
.bar .fill{position:relative;height:100%;width:0;background:linear-gradient(90deg,var(--acc),var(--acc2));border-radius:9px;transition:width 1.4s cubic-bezier(.2,.7,.2,1)}
/* reflet lumineux qui passe sur la barre */
.bar .fill::after{content:"";position:absolute;top:0;bottom:0;width:40px;left:-40px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.7),transparent);animation:shine 2.8s 1.6s infinite}
/* une couleur différente par langage */
.bar:nth-of-type(2) .fill{background:linear-gradient(90deg,#a78bfa,var(--pink))}
.bar:nth-of-type(3) .fill{background:linear-gradient(90deg,var(--warm),var(--pink))}
.bar:nth-of-type(4) .fill{background:linear-gradient(90deg,var(--acc2),var(--acc))}
.bar:nth-of-type(5) .fill{background:linear-gradient(90deg,#ffd86b,var(--warm))}
.niveau{margin:-8px 0 20px;color:var(--mute);font-size:.93rem}
.niveau b{color:var(--warm)}
@keyframes shine{to{left:110%}}

.rings{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:16px;margin-top:28px}
.ring{text-align:center}
.ring svg{width:110px;height:110px;transform:rotate(-90deg)}
.ring circle{fill:none;stroke-width:9}
.ring .bg{stroke:var(--line)}
.ring .val{stroke:var(--acc2);stroke-linecap:round;stroke-dasharray:283;stroke-dashoffset:283;transition:stroke-dashoffset 1.6s cubic-bezier(.2,.7,.2,1)}
.ring .num{margin-top:-72px;height:72px;font-weight:800;font-size:1.3rem}
.ring p{margin:0;color:var(--mute);font-size:.9rem}

.tags{display:flex;flex-wrap:wrap;gap:8px;margin:0;padding:0;list-style:none}
.tags li{background:var(--soft);padding:4px 12px;border-radius:99px;font-size:.9rem;transition:transform .2s,background .2s}
.tags li:hover{background:var(--acc);color:#000;transform:translateY(-3px)}
/* les tags apparaissent un par un */
.js .tags li{opacity:0;transform:scale(.6)}
.js .in .tags li,.js .tags.in li{opacity:1;transform:none;transition:opacity .4s,transform .4s cubic-bezier(.3,1.6,.5,1)}

.qualites{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px;margin-top:28px}
