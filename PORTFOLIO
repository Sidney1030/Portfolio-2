<script>
/* ===== A. Fait apparaître les blocs quand on scrolle ===== */
const vu = new IntersectionObserver((liste) => {
  liste.forEach((e) => {
    if (!e.isIntersecting) return;
    e.target.classList.add("in");
    vu.unobserve(e.target);
    if (e.target.id === "bars") animerBarres();
    if (e.target.id === "rings") animerAnneaux();
  });
}, { threshold: 0.15 });
document.querySelectorAll(".reveal, .tags, #rings").forEach((el) => vu.observe(el));

/* Les tags d’un même groupe arrivent l’un après l’autre */
document.querySelectorAll(".tags").forEach((ul) => {
  ul.querySelectorAll("li").forEach((li, i) => (li.style.transitionDelay = i * 90 + "ms"));
});

/* ===== B. Compteur : fait monter un nombre de 0 à la valeur ===== */
function compter(el, cible, duree) {
  const debut = performance.now();
  function pas(maintenant) {
    const t = Math.min((maintenant - debut) / duree, 1);
    const ease = 1 - Math.pow(1 - t, 3);
    el.textContent = Math.round(cible * ease) + "%";
    if (t < 1) requestAnimationFrame(pas);
  }
  requestAnimationFrame(pas);
}

/* ===== C. Barres de compétences ===== */
function animerBarres() {
  document.querySelectorAll(".bar").forEach((barre, i) => {
    const niveau = Number(barre.dataset.niveau);
    setTimeout(() => {
      barre.querySelector(".fill").style.width = niveau + "%";
      compter(barre.querySelector(".pct"), niveau, 1400);
    }, i * 150);
  });
}

/* ===== D. Anneaux (le cercle fait 283 de long, voir le CSS) ===== */
function animerAnneaux() {
  document.querySelectorAll(".ring").forEach((anneau) => {
    const niveau = Number(anneau.dataset.niveau);
    anneau.querySelector(".val").style.strokeDashoffset = 283 - (283 * niveau) / 100;
    compter(anneau.querySelector(".num"), niveau, 1600);
  });
}

/* ===== E. Filtre des projets ===== */
const boutons = document.querySelectorAll(".filters button");
boutons.forEach((b) => b.addEventListener("click", () => {
  boutons.forEach((x) => x.setAttribute("aria-pressed", x === b));
  document.querySelectorAll(".proj").forEach((p) => {
    p.hidden = b.dataset.f !== "all" && p.dataset.type !== b.dataset.f;
  });
}));

/* ===== F. Surligne le lien du menu de la section visible ===== */
const liens = document.querySelectorAll("nav a");
const menu = new IntersectionObserver((liste) => {
  liste.forEach((e) => {
    if (e.isIntersecting) liens.forEach((a) => a.classList.toggle("on", a.getAttribute("href") === "#" + e.target.id));
  });
}, { rootMargin: "-45% 0px -50% 0px" });
document.querySelectorAll("section[id]").forEach((s) => menu.observe(s));
</script>
